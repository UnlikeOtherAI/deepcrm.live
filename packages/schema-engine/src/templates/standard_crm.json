  "matching_rules": {
    "person": [
      {
        "attributes": [
          "emails"
        ],
        "method": "normalized",
        "action": "block"
      },
      {
        "attributes": [
          "name",
          "company"
        ],
        "method": "normalized",
        "action": "warn"
      }
    ],
    "company": [
      {
        "attributes": [
          "domains"
        ],
        "method": "normalized",
        "action": "block"
      },
      {
        "attributes": [
          "name"
        ],
        "method": "fuzzy",
        "threshold": 0.6,
        "action": "warn"
      }
    ],
    "deal": [
      {
        "attributes": [
          "name",
          "company"
        ],
        "method": "normalized",
        "action": "warn"
      }
    ]
