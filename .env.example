# Every variable from docs/architecture.md §6 with local-dev values.

DEEPCRM_API_PORT=5656
DEEPCRM_API_PUBLIC_URL=http://localhost:5656
DATABASE_URL=postgresql://deepcrm:deepcrm@localhost:5657/deepcrm
DEEPCRM_PROCESS_MODE=all
REQUIRE_AUTH=false
DEEPCRM_APPS=
UOA_BASE_URL=https://authentication.unlikeotherai.com
DEEPCRM_DIRECT_CLIENTS=false
DEEPCRM_UOA_CONFIG_PRIVATE_KEY_B64=
DEEPCRM_UOA_CLIENT_SECRET=
DEEPCRM_SECRET_KEYRING_B64=
LEDGER_PUBLIC_URL=
LEDGER_PROXY_TOKEN=
DEEPCRM_EMBEDDING_MODEL=jina-embeddings-v3
DEEPCRM_MAX_BULK_ROWS=10000
DEEPCRM_MAX_BODY_BYTES=10485760
DEEPCRM_MAX_EXPORT_ROWS=100000
DEEPCRM_EXPORT_DIR=./.exports
DEEPCRM_ORG_ALLOWLIST=
DEEPCRM_AUDIT_RETENTION_YEARS=7
DEEPCRM_RETENTION_DAYS=30
DEEPCRM_TRUSTED_PROXY_HOPS=0
